{
  "name": "ventasfix-api",
  "version": "1.0.0",
  "description": "VentasFix backend API (data layer: config, models, migrations, seeders)",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:reset": "sequelize-cli db:seed:undo:all && sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "sequelize": "6.37.8",
    "pg": "8.23.0",
    "pg-hstore": "2.3.4",
    "sequelize-cli": "6.6.5",
    "bcrypt": "6.0.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "cors": "2.8.6",
    "helmet": "8.3.0",
    "express-rate-limit": "8.7.0",
    "jsonwebtoken": "9.0.3",
    "zod": "4.6.5",
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "swagger-ui-express": "5.0.1",
    "multer": "2.4.0",
    "axios": "1.20.0"
  },
  "devDependencies": {
    "nodemon": "3.1.14",
    "jest": "30.5.1",
    "supertest": "7.2.2"
  }
}
