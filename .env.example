# Copy this file to `.env` before starting anything: both docker-compose
# files load it through `env_file`, and the api / test suite read it when
# running directly on the host. The compose files override DB_HOST with the
# `postgres` service name, so the value below only matters outside Docker.

# --- PostgreSQL connection -------------------------------------------------
# Hostname of the PostgreSQL server. Use "postgres" (the compose service
# name) when running the api container, "localhost" when running on the host.
DB_HOST=localhost
# PostgreSQL port the api connects to (inside the Docker network: 5432).
DB_PORT=5432
# Host port docker-compose publishes the postgres container on. Change it
# if a local PostgreSQL already listens on 5432; `npm test` on the host
# uses this value automatically.
DB_HOST_PORT=5432
# Database name. The test suite uses "<DB_NAME>_test" automatically.
DB_NAME=ventasfix
# PostgreSQL role used by the api to connect.
DB_USER=ventasfix
# Password for DB_USER. Never commit the real value.
DB_PASSWORD=ventasfix

# --- Auth -------------------------------------------------------------------
# Secret used to sign and verify JWTs. Use a long random string in real
# environments.
JWT_SECRET=change-me-in-production
# JWT lifetime, in a value accepted by the `jsonwebtoken` library (e.g. "1h").
JWT_EXPIRES_IN=1h
# bcrypt cost factor used to hash user passwords.
BCRYPT_ROUNDS=12

# --- Business rules ----------------------------------------------------------
# VAT rate applied to derive products.sale_price from products.net_price.
# Never hardcode this value in source code.
TAX_RATE=0.19

# --- Softland integration (mocked ERP) --------------------------------------
# Base URL of the Softland mock service.
SOFTLAND_BASE_URL=http://softland-mock:4000
# API key the Softland mock expects in the `x-api-key` header.
SOFTLAND_API_KEY=softland-dev-key

# --- File uploads (ADR-008) --------------------------------------------------
# Absolute path (inside the api container) where product images are stored.
UPLOAD_DIR=/app/uploads
# Maximum accepted upload size, in bytes (2097152 = 2 MB).
MAX_UPLOAD_SIZE=2097152
# Comma-separated whitelist of accepted image MIME types.
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# --- HTTP ---------------------------------------------------------------------
# Comma-separated whitelist of origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173
# Port the api HTTP server listens on.
PORT=3000
